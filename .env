NODE_ENV=production
PORT=3002
DATABASE=mongodb://mongo:27017/db
DATABASE_PASSWORD='<your_mongodb_password>'

JWT_SECRET='<a_secret_to_sign_token>'
# in days
JWT_EXPIRES_IN='10d'
JWT_COOKIE_EXPIRES_IN=10
TEMP_FRONTEND_IP_ACCESS='<custom_ip>'

# MONGO
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_URI=mongodb://dev:dev@localhost:27017/db
MONGO_INITDB_DATABASE=root-db
MONGO_USER=dev
MONGO_PASSWORD=dev
MONGO_DB=db